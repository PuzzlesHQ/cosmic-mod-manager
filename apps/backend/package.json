{
    "name": "@app/backend",
    "module": "src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "build": "bun run build.ts",
        "start": "bun run build/index.js",
        "prisma-generate": "prisma generate --sql",
        "prisma-push": "prisma db push",
        "deploy": "NODE_ENV=production pm2 deploy pm2.config.cjs backend",
        "file-backup": "bun run src/services/storage/backup/index.ts",
        "openapi-docs": "bunx @rcmade/hono-docs generate --config ./hono-docs.ts"
    },
    "dependencies": {
        "@app/utils": "workspace:*",
        "@clickhouse/client": "^1.23.1",
        "@oslojs/encoding": "^1.1.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@scalar/hono-api-reference": "^0.11.16",
        "hono": "^4.13.3",
        "ioredis": "^5.11.1",
        "meilisearch": "^0.60.0",
        "nanoid": "^6.0.1",
        "nodemailer": "^9.0.5",
        "pg": "^8.23.0",
        "semver": "^7.8.5",
        "sharp": "^0.35.3"
    },
    "devDependencies": {
        "@rcmade/hono-docs": "^1.3.0",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.23.1",
        "@types/semver": "^7.8.0",
        "@types/xml2js": "^0.4.14",
        "prisma": "^7.9.1",
        "xml2js": "^0.6.2"
    }
}
